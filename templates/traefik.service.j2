# {{ ansible_managed }}
[Unit]
Description=Traefik
Documentation=https://doc.traefik.io/traefik/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ traefik_user }}
Group={{ traefik_group }}
{% set traefik_unit_env_file = traefik_env_file if traefik_env_file | length > 0
   else ((traefik_config_dir ~ '/env') if traefik_acme_dns_provider | length > 0 else '') %}
{% if traefik_unit_env_file %}
# Credentials for ACME DNS providers (lego) and other secrets, kept out of the
# static configuration file. The leading dash tolerates a missing file, which
# the consuming playbook or vault creates out-of-band.
EnvironmentFile=-{{ traefik_unit_env_file }}
{% endif %}
ExecStart={{ traefik_install_dir }}/traefik --configFile={{ traefik_config_dir }}/traefik.yml
Restart=on-failure
RestartSec=5s
# Allow the unprivileged service user to bind ports 80 and 443.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ traefik_data_dir }}

[Install]
WantedBy=multi-user.target
